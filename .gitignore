
# Ignore migw files
tools/mingw/**

# Ignore compiled files folder
obj
build

# Ignore all files in CoD2 windows folder except for certain files
bin/windows/*
!bin/windows/cod.bmp
!bin/windows/CoD2MP_s.exe
!bin/windows/CoD2MP_s.exe.bndb
!bin/windows/cod2patch.ini
!bin/windows/CoD2SP_s.exe
!bin/windows/codlogo.bmp
!bin/windows/gfx_d3d_mp_x86_s.dll
!bin/windows/gfx_d3d_mp_x86_s.dll.bndb
!bin/windows/gfx_d3d_x86_s.dll
!bin/windows/localization.txt
!bin/windows/mss32_original.dll
!bin/windows/version.inf
# mss32.dll is deliberately NOT whitelisted: it is a build output, and CI
# proves it is reproducible from source. See below.

# Ignore all folders in CoD2 windows folder except for main, miles, and pb
bin/windows/*/
!bin/windows/main
!bin/windows/miles/
!bin/windows/pb/

# Ignore all files in main folder except for certain files
bin/windows/main/*
!bin/windows/main/launch_*.cfg
!bin/windows/main/_callback_*.gsc

# Ignore all folders in main folder except for players
bin/windows/main/*/
!bin/windows/main/players
bin/windows/main/players/default/config_mp.cfg

# Large Binary Ninja pseudo-C dumps - keep locally, too big for GitHub
src/other/*.bndb_pseudo_c.txt

# -----------------------------------------------------------------------------
# Build outputs
#
# These are produced by the build and reproducible from source (CI rebuilds both
# and requires byte-identical output), so tracking them adds no information.
# It also actively hurts: every build dirtied the working tree, each version bump
# added another uncompressible multi-megabyte copy to history, and a pull request
# that carried a rebuilt binary could not be checked against its own source. A
# contributor without a Windows machine cannot produce mss32.dll at all, which
# made shared-code changes impossible to submit completely.
#
# Original game files in bin/ (CoD2MP_s.exe, mss32_original.dll, gfx_*.dll,
# miles/, cod2_lnxded) are NOT build outputs and stay tracked.
# -----------------------------------------------------------------------------
bin/linux/libCoD2x.so

# Generated by `make prebuild` from the VERSION_* variables in the makefile,
# which is the single source of truth for the version.
src/shared/version.h
src/mss32/version.rc

# zip/ holds locally packaged releases. release.yml now builds the archives in CI
# from source and attaches them to the GitHub release, so nothing here needs to
# be committed except the manual that goes inside them.
zip/windows/*
!zip/windows/*.txt
zip/linux/*
!zip/linux/*.txt
